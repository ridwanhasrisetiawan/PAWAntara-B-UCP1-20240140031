# Salin file ini menjadi .env lalu isi nilainya sebelum menjalankan server.
# .env TIDAK ikut di-commit (lihat .gitignore).

# Secret untuk session login (bebas diisi string acak apa saja)
SESSION_SECRET=ganti-dengan-string-acak-yang-panjang

# Kredensial admin/kasir
ADMIN_USERNAME=admin
# ADMIN_PASSWORD_HASH adalah hasil hash bcrypt dari password admin.
# Generate dengan: node -e "console.log(require('bcryptjs').hashSync('password_kamu', 10))"
ADMIN_PASSWORD_HASH=

PORT=3000
