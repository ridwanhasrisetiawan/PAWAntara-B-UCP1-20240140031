<!DOCTYPE html>
<html lang="id">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-paper text-ink font-body">
  <%- include('partials/navbar') %>

  <main id="main-content" class="max-w-6xl mx-auto px-4 sm:px-6">
    <section class="pt-10 pb-6">
      <span class="inline-block bg-tag text-ink text-xs font-bold uppercase tracking-widest px-3 py-1 rounded-full mb-3 -rotate-1 border-2 border-ink">Katalog</span>
      <h1 class="font-display font-black text-3xl sm:text-4xl mb-1">Daftar Produk</h1>
      <p class="text-ink/70">Semua kebutuhan pokok yang tersedia di Toko Sembako Ariesta.</p>
    </section>

    <section aria-labelledby="filter-title" class="py-4">
      <h2 id="filter-title" class="sr-only">Filter Produk</h2>
      <form id="filterForm" class="bg-white border-2 border-ink rounded-2xl p-5 flex flex-wrap items-end gap-4" style="box-shadow: 4px 4px 0 0 #1c2b22;">
        <div class="flex flex-col gap-1 flex-1 min-w-[200px]">
          <label for="search" class="text-sm font-bold">Cari nama produk</label>
          <input
            type="search"
            id="search"
            name="search"
            placeholder="Contoh: beras"
            class="border-2 border-ink/30 rounded-xl px-3 py-2 text-sm focus:outline-none focus:border-market"
          />
        </div>

        <div class="flex flex-col gap-1 flex-1 min-w-[200px]">
          <label for="kategori" class="text-sm font-bold">Kategori</label>
          <select id="kategori" name="kategori" class="border-2 border-ink/30 rounded-xl px-3 py-2 text-sm focus:outline-none focus:border-market">
            <option value="">Semua Kategori</option>
          </select>
        </div>

        <div class="flex gap-2">
          <button type="submit" class="px-5 py-2.5 rounded-full font-bold bg-spice text-paper border-2 border-ink hover:-translate-y-0.5 transition-transform">Terapkan Filter</button>
          <button type="button" id="resetFilterBtn" class="px-5 py-2.5 rounded-full font-bold bg-paper text-ink border-2 border-ink hover:-translate-y-0.5 transition-transform">Reset</button>
        </div>
      </form>
    </section>

    <section aria-labelledby="list-title" class="py-6 pb-16">
      <h2 id="list-title" class="sr-only">Hasil Produk</h2>
      <p id="resultCount" class="text-ink/60 mb-4 text-sm"></p>
      <div id="productGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 pt-3">
        <p class="col-span-full text-center text-ink/50 py-12 font-display">Memuat produk...</p>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>

  <script src="/js/main.js"></script>
  <script src="/js/produk.js"></script>
</body>
</html>
